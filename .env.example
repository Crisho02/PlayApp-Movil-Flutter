# PlayApp Móvil Flutter - Variables de Entorno de Configuración
# Copia este archivo como .env para desarrollo local si es necesario.

# URL base del Backend Spring Boot REST API
# - Emulador Android: http://10.0.2.2:8080
# - Emulador iOS / Web / Desktop: http://localhost:8080
# - Dispositivo Físico (misma red Wi-Fi): http://<TU_IP_LOCAL>:8080
API_BASE_URL=http://10.0.2.2:8080

# Tarifa estándar de entrega en carpa en playas de Cartagena (COP)
STANDARD_DELIVERY_FEE=5000

# Integración Wompi Sandbox (Bancolombia)
# Nota: La aplicación móvil únicamente utiliza la llave pública (pub_test_*) para inicialización y verificación segura.
# Las llaves privadas (prv_test_*) y secretos de integridad residen exclusivamente en el backend Spring Boot.
WOMPI_PUBLIC_KEY=pub_test_wQdG7hGgqZc6hK7v9b8a1c2d3e4f5a6b
WOMPI_CURRENCY=COP

# Tarjetas de Prueba Wompi Sandbox
TEST_CARD_APPROVED=4242424242424242
TEST_CARD_REJECTED=4111111111111111
